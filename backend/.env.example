# Copy to backend/.env and fill in. Never commit the real .env.

# ---------- HTTP ----------
# Comma-separated list of allowed browser origins for CORS (scheme + host, no path).
# Include https://sdrf.quantms.org so a locally running backend can serve the
# official embedded editor. Add any other hosted frontend origin you use.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://sdrf.quantms.org,https://2024-denglei.github.io,http://www.sdrf.site,https://www.sdrf.site,http://47.93.36.196

# ---------- LLM (OpenAI-compatible chat completions with tool calling) ----------
# Works with OpenAI, DeepSeek, Qwen/DashScope compatible mode, OpenRouter,
# vLLM, Ollama (http://localhost:11434/v1), etc.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
# DeepSeek: low/high/max; empty keeps provider default. low keeps thinking enabled.
LLM_REASONING_EFFORT=
LLM_MAX_TOOL_ROUNDS=16
LLM_TIMEOUT_SECONDS=120
# Enable only if the gateway supports stream_options.include_usage.
LLM_STREAM_INCLUDE_USAGE=false

# ---------- Embeddings (for the SDRF specification knowledge base) ----------
# OpenAI-compatible /embeddings endpoint. Leave EMBEDDING_API_KEY empty to fall
# back to lexical-only retrieval (works offline, lower quality).
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Some providers (e.g. DashScope-compatible) cap batch size at 10–20.
EMBEDDING_BATCH_SIZE=10

# ---------- PDF parsing (MinerU) ----------
# MINERU_MODE: api (default, proxy to a MinerU service) | local (local mineru CLI)
MINERU_MODE=api
# MINERU_FLAVOR: official (hosted mineru.net v4) | simple (self-hosted POST /file_parse)
MINERU_FLAVOR=official
# MinerU online API, or your self-hosted deployment.
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_API_KEY=
MINERU_TIMEOUT_SECONDS=300
MINERU_POLL_INTERVAL_SECONDS=5

# ---------- Knowledge base ----------
SPEC_URL=https://sdrf.quantms.org/specification.html
SPEC_INDEX_DIR=data/spec_index
SPEC_SOURCE_FILE=data/spec/specification.md

# Curated cell-line / Cellosaurus tables (from sdrf-proteomics/) + vector index.
# Build with: python -m app.celllines.build_index
CELLLINE_DB_FILE=../sdrf-proteomics/cl-annotations-db.tsv
CELLLINE_SYNONYMS_FILE=../sdrf-proteomics/ai-synonyms.tsv
CELLLINE_INDEX_DIR=data/cellline_index

# ---------- Misc ----------
MAX_UPLOAD_MB=30
SESSION_TTL_SECONDS=7200

# DOI fallback after Europe PMC XML/PDF acquisition fails; empty disables it.
SCIHUB_BASE_URL=https://www.sci-hub.ee/
# Direct connections only for Sci-Hub discovery and its discovered PDF downloads.
# Set true to use HTTP_PROXY/HTTPS_PROXY/ALL_PROXY for these requests too.
SCIHUB_TRUST_ENV=false
PUBLICATION_CACHE_DIR=data/publications
PUBLICATION_CACHE_TTL_SECONDS=604800
PUBLICATION_CACHE_MAX_MB=256
